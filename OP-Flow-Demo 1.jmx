    def v = vars.get(name)
    if (!v || v == &quot;NOT_FOUND&quot; || v == &quot;null&quot;) return fallback
    try { return new BigDecimal(v.replaceAll(&quot;,&quot;,&quot;&quot;)).longValue() } catch (Exception e) { return fallback }
}
def toNum = { name, fallback -&gt;
    def v = vars.get(name)
    if (!v || v == &quot;NOT_FOUND&quot; || v == &quot;null&quot;) return fallback
    try { return new BigDecimal(v.replaceAll(&quot;,&quot;,&quot;&quot;)) } catch (Exception e) { return fallback }
}
def amt = new BigDecimal(&quot;810&quot;)
def amtDec = &quot;810.00&quot;
vars.put(&quot;billAmount&quot;, &quot;810&quot;)
vars.put(&quot;billAmountDec&quot;, &quot;810.00&quot;)
