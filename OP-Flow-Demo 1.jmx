            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">patientId;mpi;patientName;patientGender;patientPhone</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.id;$.mpi;$.patientName;$.gender;$.mobileNumber</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1;1;1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND;NOT_FOUND;NOT_FOUND;NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Map Patient Booking Fields" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def genderCode = (vars.get(&quot;gender&quot;) ?: &quot;&quot;).trim().toUpperCase()
if (genderCode == &quot;F&quot;) {
    vars.put(&quot;patientGenderBook&quot;, &quot;Female&quot;)
} else if (genderCode == &quot;M&quot;) {
    vars.put(&quot;patientGenderBook&quot;, &quot;Male&quot;)
} else {
    vars.put(&quot;patientGenderBook&quot;, vars.get(&quot;patientGender&quot;) ?: &quot;Male&quot;)
}

def apiName = vars.get(&quot;patientName&quot;)
if (apiName &amp;&amp; apiName != &quot;NOT_FOUND&quot;) {
    vars.put(&quot;patientNameBook&quot;, apiName.replaceAll(&quot;\\s+&quot;, &quot; &quot;).trim())
} else {
    vars.put(&quot;patientNameBook&quot;, ((vars.get(&quot;firstName&quot;) ?: &quot;&quot;) + &quot; &quot; + (vars.get(&quot;lastName&quot;) ?: &quot;&quot;)).trim())
}

def phone = vars.get(&quot;patientPhone&quot;)
if (!phone || phone == &quot;NOT_FOUND&quot;) {
    vars.put(&quot;patientPhone&quot;, vars.get(&quot;mobile&quot;) ?: &quot;&quot;)
}

vars.put(&quot;patientDob&quot;, &quot;2003-08-17T00:00:00.000Z&quot;)
if (!vars.get(&quot;username&quot;) || vars.get(&quot;username&quot;) == &quot;NOT_FOUND&quot;) {
    vars.put(&quot;username&quot;, &quot;akash&quot;)
}
log.info(&quot;Registered patientId=&quot; + vars.get(&quot;patientId&quot;) + &quot; mpi=&quot; + vars.get(&quot;mpi&quot;))</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
