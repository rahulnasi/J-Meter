          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="/api-gateway/core/patient/op/quick/register-258" enabled="true">
            <stringProp name="HTTPSampler.domain">demo.medvistaglobal.com</stringProp>
            <stringProp name="HTTPSampler.port">443</stringProp>
