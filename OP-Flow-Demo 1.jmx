                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Set canBill" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
def raw = prev.getResponseDataAsString() ?: &quot;&quot;
def ref = vars.get(&quot;appointmentReferenceId&quot;)
try {
    def json = new JsonSlurper().parseText(raw)
    def data = (json instanceof Map) ? json.data : null
    if (data instanceof Map &amp;&amp; data.id) {
        vars.put(&quot;appointmentReferenceId&quot;, data.id.toString())
        ref = data.id.toString()
    }
    log.info(&quot;book status=&quot; + (json instanceof Map ? json.status : &quot;&quot;) + &quot; message=&quot; + (json instanceof Map ? json.message : &quot;&quot;) + &quot; code=&quot; + prev.getResponseCode() + &quot; appointmentReferenceId=&quot; + ref)
    if (!ref || ref == &quot;NOT_FOUND&quot;) log.info(&quot;book body=&quot; + (raw.length() &gt; 400 ? raw.substring(0, 400) : raw))
} catch (Exception e) {
    log.info(&quot;book parse fail code=&quot; + prev.getResponseCode() + &quot; body=&quot; + (raw.length() &gt; 400 ? raw.substring(0, 400) : raw))
}
if (!ref) { vars.put(&quot;appointmentReferenceId&quot;, &quot;NOT_FOUND&quot;); ref = &quot;NOT_FOUND&quot; }</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
