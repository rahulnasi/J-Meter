                    <stringProp name="script">import groovy.json.JsonSlurper
def raw = prev.getResponseDataAsString() ?: &quot;{}&quot;
log.info(&quot;RECEIVABLES code=&quot; + prev.getResponseCode() + &quot; body=&quot; + (raw.length() &gt; 900 ? raw.substring(0, 900) : raw))
def json
try { json = new JsonSlurper().parseText(raw) } catch (Exception e) { json = [:] }
def foundItem = null
def foundAmt = null
def walk
walk = { obj -&gt;
    if (obj instanceof Map) {
        def items = obj.saleOrderItemDetails ?: obj.salesOrderItems ?: obj.billItems
        if (!foundItem &amp;&amp; items instanceof List &amp;&amp; items &amp;&amp; items[0] instanceof Map) {
            def it = items[0]
            foundItem = it.id ?: it.salesOrderItemId ?: it.saleOrderItemId
            foundAmt = it.net ?: it.amount ?: it.patientPayable ?: it.gross
        }
        if (!foundItem &amp;&amp; (obj.salesOrderItemId || (obj.id != null &amp;&amp; obj.commonNameIdentifierCode))) {
            foundItem = obj.salesOrderItemId ?: obj.id
        }
        obj.values().each { walk(it) }
    } else if (obj instanceof List) {
        obj.each { walk(it) }
    }
}
walk(json)
if (foundItem) vars.put(&quot;salesOrderItemId&quot;, foundItem.toString())
if (foundAmt != null) {
    vars.put(&quot;billAmount&quot;, foundAmt.toString())
    try { vars.put(&quot;billAmountDec&quot;, String.format(java.util.Locale.US, &quot;%.2f&quot;, new BigDecimal(foundAmt.toString()).doubleValue())) } catch (Exception ignored) {}
}
log.info(&quot;RECEIVABLES itemId=&quot; + vars.get(&quot;salesOrderItemId&quot;) + &quot; amount=&quot; + vars.get(&quot;billAmount&quot;))</stringProp>
