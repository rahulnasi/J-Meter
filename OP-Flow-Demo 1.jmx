            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
  &quot;name&quot;: {&#xd;
    &quot;firstname&quot;: &quot;${firstName}&quot;,&#xd;
    &quot;middlename&quot;: &quot;&quot;,&#xd;
    &quot;lastname&quot;: &quot;${lastName}&quot;&#xd;
  },&#xd;
  &quot;aliasName&quot;: &quot;&quot;,&#xd;
  &quot;salutaionIdentifierCode&quot;: &quot;Mr&quot;,&#xd;
  &quot;age&quot;: ${age},&#xd;
  &quot;dob&quot;: 843416999000,&#xd;
  &quot;estimatedAge&quot;: true,&#xd;
  &quot;genderIdentifier&quot;: &quot;${gender}&quot;,&#xd;
  &quot;email&quot;: &quot;&quot;,&#xd;
  &quot;telecom&quot;: {&#xd;
    &quot;countryCode&quot;: &quot;+91&quot;,&#xd;
    &quot;number&quot;: &quot;${mobile}&quot;,&#xd;
    &quot;telecomTypeIdentifier&quot;: &quot;Mobile&quot;&#xd;
  },&#xd;
  &quot;secondaryMobileNumber&quot;: {&#xd;
    &quot;countryCode&quot;: &quot;+91&quot;,&#xd;
    &quot;number&quot;: &quot;&quot;,&#xd;
    &quot;telecomTypeIdentifier&quot;: &quot;Mobile&quot;&#xd;
  },&#xd;
  &quot;customerTransactionBase&quot;: {&#xd;
    &quot;active&quot;: true,&#xd;
    &quot;customerId&quot;: 2,&#xd;
    &quot;customerBusinessId&quot;: 2,&#xd;
    &quot;siteId&quot;: 2&#xd;
  },&#xd;
  &quot;primaryAddress&quot;: {&#xd;
    &quot;nationality&quot;: &quot;IND&quot;,&#xd;
    &quot;nationalityName&quot;: &quot;Indian&quot;,&#xd;
    &quot;frroNumber&quot;: null&#xd;
  },&#xd;
  &quot;patientReffer&quot;: null,&#xd;
  &quot;patientAttribute&quot;: {&#xd;
    &quot;isVip&quot;: false,&#xd;
    &quot;patientCategory&quot;: []&#xd;
  },&#xd;
  &quot;source&quot;: &quot;FDM&quot;,&#xd;
  &quot;isTemp&quot;: false&#xd;
}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
