                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Sales Order" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">false</stringProp>
                    <stringProp name="script">import groovy.json.JsonSlurper
def raw = prev.getResponseDataAsString() ?: &quot;{}&quot;
log.info(&quot;SALES_ORDERS code=&quot; + prev.getResponseCode() + &quot; body=&quot; + (raw.length() &gt; 900 ? raw.substring(0, 900) : raw))
def json
try { json = new JsonSlurper().parseText(raw) } catch (Exception e) { log.error(&quot;sales order parse failed &quot; + e.message); json = [:] }
def data = (json instanceof Map) ? (json.data != null ? json.data : json) : json
def order = null
if (data instanceof List &amp;&amp; data) {
    order = data.find { it instanceof Map &amp;&amp; (it.salesOrderId || it.saleOrderItemDetails || it.salesOrderItems) } ?: data[0]
} else if (data instanceof Map) {
    if (data.salesOrders instanceof List &amp;&amp; data.salesOrders) order = data.salesOrders[0]
    else if (data.content instanceof List &amp;&amp; data.content) order = data.content[0]
    else order = data
}
def numOr = { v -&gt; if (v == null) return null; def s = v.toString().replaceAll(&quot;,&quot;,&quot;&quot;); if (!s.isNumber()) return null; return new BigDecimal(s) }
if (order instanceof Map) {
    def sid = order.salesOrderId ?: order.saleOrderId ?: order.id
    if (sid != null) vars.put(&quot;salesOrderId&quot;, sid.toString())
    def amt = order.netPayable ?: order.totalPatientPayable ?: order.patientPayable ?: order.amount ?: order.gross ?: order.net
    def items = order.saleOrderItemDetails ?: order.salesOrderItems ?: order.items ?: order.saleOrderItems
    if (items instanceof List &amp;&amp; items &amp;&amp; items[0] instanceof Map) {
        def it = items[0]
        def iid = it.id ?: it.salesOrderItemId
        if (iid != null) vars.put(&quot;salesOrderItemId&quot;, iid.toString())
        if (it.net != null) amt = it.net
        else if (it.amount != null) amt = it.amount
        else if (it.patientPayable != null) amt = it.patientPayable
        if (it.catalogueItemId) vars.put(&quot;catalogueItemId&quot;, it.catalogueItemId.toString())
    }
    if (amt != null) {
        def n = numOr(amt)
        if (n != null) {
            vars.put(&quot;billAmount&quot;, n.stripTrailingZeros().toPlainString())
            vars.put(&quot;billAmountDec&quot;, String.format(java.util.Locale.US, &quot;%.2f&quot;, n.doubleValue()))
        }
    }
}
