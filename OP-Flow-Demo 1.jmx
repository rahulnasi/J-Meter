              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Consult Token">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
def response = prev.getResponseDataAsString()
if (response) {
    try {
        def json = new JsonSlurper().parseText(response)
        def patId = vars.get(&quot;patientId&quot;)
        def apptId = vars.get(&quot;coreAppointmentId&quot;)
        def list = json?.data instanceof List ? json.data : []
        def match = list.find { 
            (patId &amp;&amp; it.personId?.toString() == patId) || 
            (apptId &amp;&amp; it.appointmentId?.toString() == apptId) 
        }
        if (match &amp;&amp; match.dashBoardId) {
            vars.put(&quot;consultTokenId&quot;, match.dashBoardId.toString())
            log.info(&quot;Found consultTokenId: &quot; + match.dashBoardId)
        } else if (list.size() &gt; 0 &amp;&amp; list[0].dashBoardId) {
            vars.put(&quot;consultTokenId&quot;, list[0].dashBoardId.toString())
            log.info(&quot;Fallback consultTokenId: &quot; + list[0].dashBoardId)
        } else {
            vars.put(&quot;consultTokenId&quot;, &quot;NOT_FOUND&quot;)
            log.warn(&quot;consultTokenId NOT FOUND in dashboard list&quot;)
        }
    } catch (Exception e) {
        log.error(&quot;Failed to parse dashboard list: &quot; + e.message)
    }
}
</stringProp>
              </JSR223PostProcessor>
