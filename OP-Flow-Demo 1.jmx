              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set Schedule Window" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.time.*

ZoneId zone = ZoneId.of(&quot;Asia/Dubai&quot;)
ZonedDateTime now = ZonedDateTime.now(zone)
ZonedDateTime start = now.toLocalDate().atStartOfDay(zone)
ZonedDateTime end = start.plusDays(7).minusNanos(1)

vars.put(&quot;scheduleFrom&quot;, String.valueOf(start.toInstant().toEpochMilli()))
vars.put(&quot;scheduleTo&quot;, String.valueOf(end.toInstant().toEpochMilli()))
log.info(&quot;Schedule window FROM=&quot; + start + &quot; TO=&quot; + end)</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Pick Free Slot" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
vars.put(&quot;slotFound&quot;, &quot;false&quot;)
if (!vars.get(&quot;encounterId&quot;)) vars.put(&quot;encounterId&quot;, &quot;NOT_FOUND&quot;)
if (!vars.get(&quot;billingPatientId&quot;)) vars.put(&quot;billingPatientId&quot;, &quot;NOT_FOUND&quot;)
if (!vars.get(&quot;coreAppointmentId&quot;)) vars.put(&quot;coreAppointmentId&quot;, &quot;NOT_FOUND&quot;)
if (!vars.get(&quot;salesOrderId&quot;)) vars.put(&quot;salesOrderId&quot;, &quot;NOT_FOUND&quot;)
if (!vars.get(&quot;salesOrderItemId&quot;)) vars.put(&quot;salesOrderItemId&quot;, &quot;NOT_FOUND&quot;)
def response = prev.getResponseDataAsString()
if (!response) {
    log.error(&quot;Scheduler response empty&quot;)
    return
}
def json
try { json = new JsonSlurper().parseText(response) } catch (Exception e) {
    log.error(&quot;Scheduler JSON parse failed&quot;, e)
    return
}
def parseMs = { value -&gt;
    if (value == null) return null
    if (value instanceof Date) return value.time
    if (value instanceof Number) return value.longValue()
    def s = value.toString().trim()
    if (!s || s == &quot;null&quot;) return null
    if (s ==~ /^-?\d+$/) return Long.parseLong(s)
    try { return OffsetDateTime.parse(s).toInstant().toEpochMilli() } catch (Exception ignored) {}
    try { return Instant.parse(s).toEpochMilli() } catch (Exception ignored2) {}
    return null
}
def isHexId = { value -&gt; value != null &amp;&amp; value.toString() ==~ /[a-fA-F0-9]{24}/ }
def events = []
if (json instanceof Map &amp;&amp; json.data instanceof List) events.addAll(json.data)
long nowMs = System.currentTimeMillis()
long windowFrom = (vars.get(&quot;scheduleFrom&quot;) ?: &quot;0&quot;) as long
long windowTo = (vars.get(&quot;scheduleTo&quot;) ?: String.valueOf(nowMs + 7L*24*3600*1000)) as long
int durationMin = 10
long durationMs = durationMin * 60L * 1000L
def bookedWords = [&quot;booked&quot;, &quot;busy&quot;, &quot;blocked&quot;, &quot;unavailable&quot;, &quot;cancelled&quot;, &quot;no-show&quot;, &quot;occupied&quot;, &quot;non_available&quot;, &quot;pending_recon&quot;]
def skip = [past:0, outsideWindow:0, patient:0, booked:0, noTime:0, noId:0, hasAppt:0]
def statuses = [:]
def bookedRanges = []
def candidates = []
events.each { item -&gt;
    if (!(item instanceof Map)) return
    def ed = item.eventData instanceof Map ? item.eventData : [:]
    def status = ((ed.eventStatus ?: &quot;&quot;) as String).toLowerCase()
    statuses[status ?: &quot;blank&quot;] = (statuses[status ?: &quot;blank&quot;] ?: 0) + 1
    def startMs = parseMs(ed.startTime ?: ed.avilablefromTime)
    def endMs = parseMs(ed.endTime ?: ed.avilabletoTime)
    def mongoId = [item.id, ed.slotId, item.slotId].find { isHexId(it) }
    def patient = ed.patientId ?: ed.patientName
    def hasPatient = patient != null &amp;&amp; patient.toString().trim() &amp;&amp; patient.toString() != &quot;null&quot; &amp;&amp; patient.toString() != &quot;0&quot;
    def hasAppt = ed.appointmentId != null &amp;&amp; ed.appointmentId.toString() != &quot;null&quot; &amp;&amp; ed.appointmentId.toString().trim()
    def blocked = ed.isBlock == true
    if (startMs != null &amp;&amp; endMs != null &amp;&amp; (hasPatient || hasAppt || blocked || bookedWords.any { status.contains(it) })) {
        bookedRanges.add([start: startMs, end: endMs])
    }
    if (hasAppt) { skip.hasAppt++; return }
    if (hasPatient) { skip.patient++; return }
    if (blocked || bookedWords.any { status.contains(it) }) { skip.booked++; return }
    if (startMs == null || endMs == null) { skip.noTime++; return }
    if (endMs &lt;= nowMs) { skip.past++; return }
    if (startMs &lt; nowMs || startMs &gt; windowTo) { skip.outsideWindow++; return }
    if (!mongoId) { skip.noId++; return }
    candidates.add([start: startMs, end: startMs + durationMs, mongoId: mongoId.toString(), numericId: (ed.id instanceof Number ? ed.id.longValue() : startMs), status: status])
}
log.info(&quot;PICKER_V3 events=&quot; + events.size() + &quot; window=&quot; + windowFrom + &quot;-&quot; + windowTo)
log.info(&quot;PICKER_V3 statusCounts=&quot; + statuses)
log.info(&quot;PICKER_V3 skip=&quot; + skip)
log.info(&quot;PICKER_V3 inWindowOpen=&quot; + candidates.size())
if (!candidates) {
    def zone = ZoneId.of(&quot;Asia/Dubai&quot;)
    def cursor = ZonedDateTime.now(zone).withSecond(0).withNano(0)
    int extra = (10 - (cursor.minute % 10)) % 10
    if (extra == 0) extra = 10
    cursor = cursor.plusMinutes(extra)
    def overlaps = { s, e -&gt; bookedRanges.any { b -&gt; s &lt; b.end &amp;&amp; e &gt; b.start } }
    def templateId = events.find { it instanceof Map &amp;&amp; isHexId(it.id) &amp;&amp; it.eventData instanceof Map &amp;&amp; it.eventData.eventStatus?.toString()?.equalsIgnoreCase(&quot;OPEN&quot;) &amp;&amp; it.eventData.patientId == null &amp;&amp; it.eventData.appointmentId == null }?.id
    while (cursor.toInstant().toEpochMilli() + durationMs &lt;= windowTo) {
        long s = cursor.toInstant().toEpochMilli()
        long e = s + durationMs
        if (cursor.hour &gt;= 8 &amp;&amp; cursor.hour &lt; 20 &amp;&amp; !overlaps(s, e) &amp;&amp; templateId) {
            candidates.add([start: s, end: e, mongoId: templateId.toString(), numericId: s, status: &quot;today-gap&quot;])
        }
        cursor = cursor.plusMinutes(10)
    }
    log.info(&quot;PICKER_V3 afterGapFill=&quot; + candidates.size() + &quot; templateId=&quot; + templateId)
}
candidates = candidates.unique { it.start }.sort { it.start }
def slot = null
synchronized (props) {
    def claimed = props.get(&quot;rahulClaimedStarts&quot;)
    if (claimed == null) {
        claimed = java.util.Collections.synchronizedSet(new java.util.LinkedHashSet())
        props.put(&quot;rahulClaimedStarts&quot;, claimed)
    }
    slot = candidates.find { c -&gt; !claimed.contains(c.start.toString()) }
    if (slot != null) claimed.add(slot.start.toString())
}
if (slot) {
    vars.put(&quot;slotFound&quot;, &quot;true&quot;)
    vars.put(&quot;slotId&quot;, slot.mongoId)
    vars.put(&quot;appointmentStartDate&quot;, slot.start.toString())
    vars.put(&quot;appointmentEndDate&quot;, slot.end.toString())
    vars.put(&quot;slotNumericId&quot;, slot.numericId.toString())
    vars.put(&quot;appointmentStartIso&quot;, Instant.ofEpochMilli(slot.start).toString())
    vars.put(&quot;doctorId&quot;, &quot;2885870&quot;)
    vars.put(&quot;doctorName&quot;, &quot;Rahul Nasi&quot;)
    vars.put(&quot;doctorFirstName&quot;, &quot;Rahul&quot;)
    vars.put(&quot;doctorLastName&quot;, &quot;Nasi&quot;)
    vars.put(&quot;doctorDepartmentId&quot;, &quot;1417&quot;)
    vars.put(&quot;specialityId&quot;, &quot;198&quot;)
    log.info(&quot;PICKER_V3 booking slotId=&quot; + slot.mongoId + &quot; start=&quot; + slot.start + &quot; end=&quot; + slot.end + &quot; iso=&quot; + vars.get(&quot;appointmentStartIso&quot;) + &quot; status=&quot; + slot.status + &quot; thread=&quot; + ctx.getThreadNum())
} else {
    log.error(&quot;PICKER_V3 no free slot today/this week for Rahul Nasi&quot;)
    vars.put(&quot;slotFound&quot;, &quot;false&quot;)
}
if (!vars.get(&quot;appointmentReferenceId&quot;)) {
    vars.put(&quot;appointmentReferenceId&quot;, &quot;NOT_FOUND&quot;)
}
log.info(&quot;canBook flags slotFound=&quot; + vars.get(&quot;slotFound&quot;) + &quot; patientId=&quot; + vars.get(&quot;patientId&quot;))</stringProp>
              </JSR223PostProcessor>
