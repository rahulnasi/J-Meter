            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Consult Sales Order" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def response = prev.getResponseDataAsString()
if (response) {
    try {
        def json = new JsonSlurper().parseText(response)
        def list = json?.data instanceof List ? json.data : (json?.data ? [json.data] : [])
        if (list.size() &gt; 0) {
            def so = list.reverse().find { it.salesOrderId != null }
            if (so) {
                vars.put(&quot;consultSalesOrderId&quot;, so.salesOrderId.toString())
                log.info(&quot;Extracted consultSalesOrderId: &quot; + so.salesOrderId)
            }
        }
    } catch (Exception e) {
        log.error(&quot;Failed to extract consultSalesOrderId: &quot; + e.message)
    }
}
</stringProp>
            </JSR223PostProcessor>
